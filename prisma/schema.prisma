generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FREELANCER
  CLIENT
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  PENDING_START
  ACTIVE
  COMPLETED
  TERMINATED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  TASK
}

enum ContractTaskStatus {
  OPEN
  DONE
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique
  password                 String
  username                 String                    @unique
  role                     Role                      @default(FREELANCER)
  coinBalance              Int                       @default(100)
  profile                  Profile?
  wallet                   Wallet?
  companyId                Int?
  company                  Company?                  @relation(fields: [companyId], references: [id])
  jobs                     Job[]                     @relation("ClientJobs")
  bids                     Bid[]
  clientContracts          Contract[]                @relation("ClientContracts")
  freelancerContracts      Contract[]                @relation("FreelancerContracts")
  clientCompletedProjects  CompletedProject[]        @relation("ClientCompletedProjects")
  freelancerCompletedProjects CompletedProject[]     @relation("FreelancerCompletedProjects")
  reviewsGiven             Review[]                  @relation("ReviewsGiven")
  reviewsReceived          Review[]                  @relation("ReviewsReceived")
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  contractTasksCreated     ContractTask[]            @relation("ContractTasksCreated")
  notifications            Notification[]
  coinTransactions         CoinTransaction[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Profile {
  id               Int     @id @default(autoincrement())
  fullName         String?
  bio              String?
  skills           String?
  services         String?
  avatar           String?
  summary          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  linkedin         String?
  github           String?
  educationEntries Json?
  projects         Json?
  userId           Int     @unique
  user             User    @relation(fields: [userId], references: [id])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  website     String?
  users       User[]
  createdAt   DateTime @default(now())
}

model Job {
  id           Int       @id @default(autoincrement())
  title        String
  description  String    @db.Text
  budget       Float
  requirements String?   @db.Text
  paymentNotes String?   @db.Text
  milestones   Json?
  images       Json?
  links        Json?
  bidCost      Int       @default(10)
  status       JobStatus @default(OPEN)
  clientId     Int
  client       User      @relation("ClientJobs", fields: [clientId], references: [id])
  bids         Bid[]
  contract     Contract?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Bid {
  id           Int       @id @default(autoincrement())
  amount       Float
  message      String    @db.Text
  status       BidStatus @default(PENDING)
  jobId        Int
  job          Job       @relation(fields: [jobId], references: [id])
  freelancerId Int
  freelancer   User      @relation(fields: [freelancerId], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([jobId, freelancerId])
}

model Contract {
  id                        Int                    @id @default(autoincrement())
  status                    ContractStatus         @default(PENDING_START)
  jobId                     Int                    @unique
  job                       Job                    @relation(fields: [jobId], references: [id])
  clientId                  Int
  freelancerId              Int
  acceptedBidId             Int?
  acceptedBidAmount         Float?
  milestoneProgress         Json?
  clientMarkedComplete      Boolean                @default(false)
  freelancerMarkedComplete  Boolean                @default(false)
  clientPaymentSent         Boolean                @default(false)
  freelancerPaymentReceived Boolean                @default(false)
  client                    User                   @relation("ClientContracts", fields: [clientId], references: [id])
  freelancer                User                   @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  completedProject          CompletedProject?
  payment                   Payment?
  blockchainTx              BlockchainTransaction?
  conversation              Conversation?
  tasks                     ContractTask[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
}

model CompletedProject {
  id           Int      @id @default(autoincrement())
  contractId   Int      @unique
  contract     Contract @relation(fields: [contractId], references: [id])
  jobId        Int
  title        String
  description  String?  @db.Text
  amount       Float?
  clientId     Int
  freelancerId Int
  client       User     @relation("ClientCompletedProjects", fields: [clientId], references: [id])
  freelancer   User     @relation("FreelancerCompletedProjects", fields: [freelancerId], references: [id])
  completedAt  DateTime @default(now())
}

model Payment {
  id           Int                    @id @default(autoincrement())
  amount       Float
  status       String
  contractId   Int                    @unique
  contract     Contract               @relation(fields: [contractId], references: [id])
  blockchainTx BlockchainTransaction?
  createdAt    DateTime               @default(now())
}

model Wallet {
  id      Int    @id @default(autoincrement())
  address String @unique
  chain   String
  userId  Int    @unique
  user    User   @relation(fields: [userId], references: [id])
}

model BlockchainTransaction {
  id         Int       @id @default(autoincrement())
  txHash     String    @unique
  chain      String
  status     String
  contractId Int?      @unique
  contract   Contract? @relation(fields: [contractId], references: [id])
  paymentId  Int?      @unique
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  createdAt  DateTime  @default(now())
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  directKey    String?                   @unique
  contractId   Int?                      @unique
  contract     Contract?                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ContractTask {
  id          Int                @id @default(autoincrement())
  contractId  Int
  contract    Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   User               @relation("ContractTasksCreated", fields: [createdById], references: [id])
  title       String
  description String?            @db.Text
  status      ContractTaskStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([contractId, status])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  taskId         Int?
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @db.Text
  link      String?
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?
  reviewerId Int
  revieweeId Int
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  createdAt  DateTime @default(now())
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
