# Pinata (pick one auth method)
# V3 uploads (recommended): https://docs.pinata.cloud — JWT needs org:files:write
PINATA_JWT=

# Legacy pinning (alternative to JWT)
# PINATA_API_KEY=
# PINATA_API_SECRET=

# Optional: full gateway base without trailing slash (default https://gateway.pinata.cloud/ipfs)
# PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# V3 only: public | private (default public — better for public avatar URLs)
# PINATA_NETWORK=public
